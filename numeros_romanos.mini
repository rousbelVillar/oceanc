var i = 0;
var r = 0;

var t = "";
var s = "IVXLCDM";


print "Ingrese un número en decimal:";
n = input();

do {
   r = n % 10;
   n = n / 10;
   select r {
        case 1:
            t = mid(s,i,1) + t;
        case 2:
            t = mid(s,i,1) + mid(s,i,1) + t;
        case 3:
            t = mid(s,i,1) + mid(s,i,1) + mid(s,i,1) + t;
        case 4:
            t = mid(s, i, 2) + t;
        case 5:
            t = mid(s, i+1,1) + t;
        case 6:
            t = mid(s,i+1,1) + mid(s,i,1) + t;
        case 7:
            t = mid(s,i+1,1) + mid(s,i,1) + mid(s,i,1) + t;
        case 8:
            t = mid(s,i+1,1) + mid(s,i,1) + mid(s,i,1) + mid(s,i,1) + t;
        case 9:
            t = mid(s,i,1) + mid(s,i+2,1) + t;
   }
   endselect
   i = i + 2;
} while (n > 0);

print "Numero romano:" + t;
